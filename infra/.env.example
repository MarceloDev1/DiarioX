# Copy to .env and fill the values. Do NOT commit .env.

# PostgreSQL
POSTGRES_DB=diariox
POSTGRES_USER=diariox
POSTGRES_PASSWORD=change-me-strong-password

# Public URL of the application (used for password reset links, etc.)
APP_URL=https://diariox.example.com

# JWT - generate a long random string (>= 32 chars). Example (Linux):
#   openssl rand -base64 48
JWT_KEY=change-me-please-with-a-long-random-string-min-32-chars
JWT_ISSUER=DiarioX.Server
JWT_AUDIENCE=DiarioX.Client
JWT_EXPIRES_IN_MINUTES=60

# SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Diário de Classe
